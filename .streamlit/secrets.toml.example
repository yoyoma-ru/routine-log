# このファイルを .streamlit/secrets.toml にコピーして値を埋める（secrets.toml はコミットしない）。
# Streamlit Cloud の場合は「Manage app → Settings → Secrets」に同じ内容を貼り付ける。

# 対象スプレッドシート（どちらか一方でOK）
spreadsheet_name = "routine-log-db"
# spreadsheet_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google サービスアカウント（study-tracker と同じものを再利用可）
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxxx@xxxx.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
